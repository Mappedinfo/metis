{
  "name": "metis",
  "version": "0.1.0",
  "private": true,
  "description": "An open agent-skill ecosystem built on the USER.md convention. Skills serve the user.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "profiles:bundle": "node scripts/bundle-profiles.mjs",
    "profiles:check": "node scripts/bundle-profiles.mjs --check",
    "skills:check": "node scripts/check-skills.mjs",
    "pretest": "npm run profiles:bundle",
    "test": "node --test test/*.test.mjs packages/metis-os/test/*.test.js",
    "check": "npm test && npm run profiles:check && npm run skills:check && npm run docs:build"
  },
  "devDependencies": {
    "markdown-it": "14.3.2",
    "metis-atlas": "0.1.0",
    "vitepress": "^1.6.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=18"
  }
}
