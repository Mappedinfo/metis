{
  "name": "metis-os",
  "version": "0.3.0",
  "description": "Scaffold the USER.md convention, install shared metis style profiles, and link metis skills into agent skill directories.",
  "keywords": [
    "agents",
    "skills",
    "user-md",
    "agents-md",
    "convention",
    "metis"
  ],
  "homepage": "https://github.com/mappedinfo/metis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mappedinfo/metis.git",
    "directory": "packages/metis-os"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "metis-os": "bin/metis-os.js"
  },
  "files": [
    "bin",
    "lib",
    "profiles",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "node ../../scripts/bundle-profiles.mjs && node ../../scripts/bundle-skills.mjs",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
